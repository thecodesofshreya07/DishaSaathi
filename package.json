{
  "name": "dishasaathi",
  "version": "1.0.0",
  "private": true,
  "description": "DishaSaathi — Municipal Bureaucracy Path Visualizer",
  "scripts": {
    "dev": "concurrently -n \"server,client\" -c \"blue,green\" \"npm run dev:server\" \"npm run dev:client\"",
    "start": "npm run dev",
    "start:prod": "node server/dist/index.js",
    "serve": "node server/dist/index.js",
    "dev:client": "cd client && npm run dev",
    "dev:server": "cd server && npm run dev",
    "build": "npm run build:server && npm run build:client",
    "build:client": "cd client && npm run build",
    "build:server": "cd server && npm run build",
    "test": "cd server && node test_phase6.js"
  },
  "keywords": [
    "civic-tech",
    "government-navigator",
    "bureaucracy-visualizer"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
